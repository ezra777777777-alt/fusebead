# API backend URL
# Local dev: http://localhost:3001/api
# Production China deployment: https://api.fusebead.cn/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Site URL for sitemap / SEO
# Local dev: http://localhost:3000
# Production China deployment: https://fusebead.cn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — create a free project at https://supabase.com
# Then copy the URL and anon key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
