# Server
PORT=3001
HOST=0.0.0.0
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=http://localhost:3000

# Database — if DATABASE_URL is set, PostgreSQL is used (production)
# If not set, SQLite is used (local dev)
# Railway sets this automatically when you link a PostgreSQL service
# DATABASE_URL=postgresql://user:pass@host:5432/db

# SMTP (email sending — using 163.com as example)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASS=your_auth_code
SMTP_FROM=your_email@163.com

# Image processor (Flask service for AI color matching)
PROCESSOR_URL=http://localhost:5000

# Alipay (sandbox for testing, live credentials for production)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
ALIPAY_NOTIFY_URL=http://localhost:3001/api/payments/webhook/alipay

# WeChat Pay
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
WECHAT_SANDBOX=true
WECHAT_NOTIFY_URL=http://localhost:3001/api/payments/webhook/wechat

# App base URL (used for constructing callback URLs in production)
APP_BASE_URL=http://localhost:3001
